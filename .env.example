# Copie ce fichier en ".env" (jamais commité dans Git) et remplis tes vraies valeurs.

# --- Session ---------------------------------------------------------------
# Chaîne aléatoire longue, différente en production. Génère-en une avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-moi-en-production

# --- Base de données PostgreSQL ---------------------------------------------
# Obligatoire. En local, utilise l'"External Database URL" de ta base sur
# Render (dashboard → ta base → Connect → External). En production, cette
# variable est fournie automatiquement par render.yaml (fromDatabase).
DATABASE_URL=

# --- Adresse publique de l'app -----------------------------------------------
# Utilisée pour construire les URLs de retour/notification CinetPay.
# En local : http://localhost:3000
# En production (Render, etc.) : https://ton-app.onrender.com
APP_BASE_URL=http://localhost:3000

# --- CinetPay (paiement Mobile Money) ---------------------------------------
# Laisse ces deux lignes VIDES pour rester en "mode démo" (changement de pack
# instantané et gratuit, pratique pour présenter l'app sans compte marchand).
# Une fois ton compte CinetPay créé sur https://cinetpay.com, renseigne-les
# pour activer les vrais paiements Orange Money / Airtel Money / M-Pesa.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Pas de variable de devise ici : le montant et la devise (CDF en RDC, XAF au
# Congo-Brazzaville) sont déterminés automatiquement selon le pays du profil
# — voir lib/plans.js (PLANS.*.pricing).

# --- Vérification du numéro par SMS (Twilio Verify) -------------------------
# Laisse ces trois lignes VIDES pour rester en "mode démo" (le code de
# vérification s'affiche directement sur la page au lieu d'être envoyé par
# SMS, pratique pour tester sans compte Twilio).
# Une fois ton compte créé sur https://twilio.com :
#  1. Récupère Account SID et Auth Token depuis la Console Twilio
#  2. Crée un "Verify Service" (Console → Verify → Services → Create) pour
#     obtenir le Service SID (commence par "VA")
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Notifications push (nouveaux matchs, nouveaux messages) ----------------
# Contrairement à CinetPay/Twilio, PAS besoin de créer de compte chez qui que
# ce soit : ces clés s'auto-génèrent en une commande et ne coûtent rien.
# Laisse-les VIDES pour désactiver les notifications (l'app fonctionne
# normalement sans). Pour les générer :
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Colle "publicKey" dans VAPID_PUBLIC_KEY et "privateKey" dans VAPID_PRIVATE_KEY.
# ⚠️ Génère-les UNE SEULE FOIS et garde-les stables : si tu les changes, tous
# les abonnements déjà enregistrés (ceux qui ont cliqué "Activer") deviennent
# invalides et devront réactiver les notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=contact@puelainvestment.com

# --- Stockage des données (production) --------------------------------------
# Chemin d'un dossier PERSISTANT (ex: le disque persistant Render) où stocker
# data.json et les photos uploadées. Laisse vide en local.
DATA_DIR=
