<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title><%= typeof title !== 'undefined' ? title : 'Rencontre Congo' %></title>
<link rel="stylesheet" href="/public/css/style.css">
<script src="/public/js/router.js" defer></script>

<!-- PWA : installable sur iOS et Android via "Ajouter à l'écran d'accueil" -->
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#E1362B">
<link rel="icon" href="/public/icons/icon-192.png" type="image/png">
<link rel="apple-touch-icon" href="/public/icons/icon-180.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Rencontre Congo">
<script>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js').catch(() => {});
    });
  }
</script>
