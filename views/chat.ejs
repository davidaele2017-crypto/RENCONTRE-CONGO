<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: (profile.name + ' — Rencontre Congo') }) %>
</head>
<body class="chat-page" data-logged-in="1">
  <div id="app-content" class="chat-shell">
    <header class="topbar">
      <a class="brand" href="/matches">← <%= profile.name %></a>
      <% if (canCall) { %>
        <div class="call-buttons">
          <button type="button" class="btn btn-round btn-small-round" onclick="startCall('<%= match.id %>', 'audio')" aria-label="Appel vocal">📞</button>
          <button type="button" class="btn btn-round btn-small-round" onclick="startCall('<%= match.id %>', 'video')" aria-label="Appel vidéo">🎥</button>
        </div>
      <% } else { %>
        <a href="/premium" class="call-locked" title="Réservé aux packs Premium et VIP">🔒 Appels</a>
      <% } %>
    </header>
    <main class="chat-window" id="chat-window" data-match-id="<%= match.id %>">
      <ul class="message-list" id="message-list">
        <% messages.forEach(m => { %>
          <li class="bubble <%= m.fromUserId === meId ? 'mine' : 'theirs' %>" data-id="<%= m.id %>"><%= m.text %></li>
        <% }) %>
      </ul>
    </main>
    <form id="chat-form" class="chat-form">
      <input type="text" id="chat-input" name="text" placeholder="Écris un message..." autocomplete="off" maxlength="2000" required>
      <button type="submit" class="btn btn-primary btn-small">Envoyer</button>
    </form>
    <script src="/public/js/calls.js"></script>
    <script src="/public/js/chat.js"></script>
  </div>
</body>
</html>
