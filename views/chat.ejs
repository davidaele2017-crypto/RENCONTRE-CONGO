<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: (profile.name + ' — Rencontre Congo') }) %>
</head>
<body class="chat-page" data-logged-in="1">
  <div id="app-content" class="chat-shell">
    <header class="topbar">
      <a class="brand chat-brand" href="/matches">
        <span class="chat-back">←</span>
        <span class="chat-contact-info">
          <span class="chat-contact-name"><%= profile.name %></span>
          <span class="chat-contact-status" id="chat-typing-status" hidden>écrit...</span>
        </span>
      </a>
      <div class="chat-header-actions">
        <% if (canCall) { %>
          <div class="call-buttons">
            <button type="button" class="btn btn-round btn-small-round" data-call-mode="audio" data-match-id="<%= match.id %>" data-contact-name="<%= profile.name %>" data-contact-photo="<%= profile.photo ? '/uploads/' + profile.photo : '' %>" aria-label="Appel vocal">📞</button>
            <button type="button" class="btn btn-round btn-small-round" data-call-mode="video" data-match-id="<%= match.id %>" data-contact-name="<%= profile.name %>" data-contact-photo="<%= profile.photo ? '/uploads/' + profile.photo : '' %>" aria-label="Appel vidéo">🎥</button>
          </div>
        <% } else { %>
          <a href="/premium" class="call-locked" title="Réservé aux packs Premium et VIP">🔒 Appels</a>
        <% } %>
        <details class="chat-menu">
          <summary aria-label="Plus d'options">⋮</summary>
          <div class="chat-menu-list">
            <a href="/signaler/<%= profile.userId %>?next=/matches">🚩 Signaler</a>
            <a href="/bloquer/<%= profile.userId %>?next=/matches">🚫 Bloquer</a>
          </div>
        </details>
      </div>
    </header>
    <main class="chat-window" id="chat-window" data-match-id="<%= match.id %>">
      <ul class="message-list" id="message-list">
        <% messages.forEach(m => { %>
          <li class="bubble <%= m.fromUserId === meId ? 'mine' : 'theirs' %>" data-id="<%= m.id %>"><%= m.text %></li>
        <% }) %>
      </ul>
    </main>
    <form id="chat-form" class="chat-form">
      <input type="text" id="chat-input" name="text" placeholder="Écris un message..." autocomplete="off" maxlength="2000" required>
      <button type="submit" class="btn btn-primary btn-small">Envoyer</button>
    </form>
    <script src="/public/js/sounds.js"></script>
    <script src="/public/js/calls.js"></script>
    <script src="/public/js/chat.js"></script>
  </div>
</body>
</html>
