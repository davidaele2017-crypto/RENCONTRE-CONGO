<!DOCTYPE html>
<html lang="fr">
<head>
  <%- include('partials/head', { title: 'Nos packs — Rencontre Congo' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="page">
    <h1>Choisis ton pack</h1>
    <p class="tagline" style="margin-bottom:18px;">Passe à un pack payant pour plus de visibilité et de fonctionnalités.</p>

    <% if (success) { %>
      <div class="alert alert-info">✅ Ton pack a été mis à jour !</div>
    <% } %>
    <% if (upsell === 'liked-me') { %>
      <div class="alert">🔒 Voir qui t'a liké(e) est réservé aux packs Premium et VIP.</div>
    <% } %>

    <p class="demo-note">⚠️ Démo : changer de pack ici est immédiat et gratuit, aucun vrai paiement n'est effectué.</p>

    <div class="plans-grid">
      <% order.forEach(planId => { const p = plans[planId]; const isCurrent = planId === currentPlanId; %>
        <div class="plan-card plan-card-<%= planId %> <%= isCurrent ? 'plan-card-current' : '' %>">
          <% if (planId === 'vip') { %><div class="plan-ribbon">Le plus populaire</div><% } %>
          <h2><%= p.name %></h2>
          <p class="plan-tagline"><%= p.tagline %></p>
          <p class="plan-price">
            <% if (p.price === 0) { %>Gratuit
            <% } else { %>$<%= p.price.toFixed(2) %><span>/mois</span><% } %>
          </p>
          <ul class="plan-features">
            <% p.features.forEach(f => { %><li><%= f %></li><% }) %>
          </ul>
          <% if (isCurrent) { %>
            <button class="btn btn-outline" disabled>Pack actuel</button>
          <% } else { %>
            <form method="POST" action="/premium/choisir">
              <input type="hidden" name="plan" value="<%= planId %>">
              <button type="submit" class="btn <%= planId === 'gratuit' ? 'btn-outline' : 'btn-primary' %>">
                <%= planId === 'gratuit' ? 'Repasser en Standard' : 'Choisir ce pack' %>
              </button>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>
  </main>
</body>
</html>
